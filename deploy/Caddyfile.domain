# Sayt va admin panel — har biri o'z manzilida, HTTPS avtomatik (Let's Encrypt)
(sec) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	# Siqish faqat statik fayllarga: jonli oqimlar (chat, yangilanishlar) bo'lakma-bo'lak kelishi kerak
	@static not path /api/*
	encode @static zstd gzip
}

__DOMAIN__ {
	import sec
	reverse_proxy 127.0.0.1:3000 {
		flush_interval -1
	}
}

admin.__DOMAIN__ {
	import sec
	reverse_proxy 127.0.0.1:3001 {
		flush_interval -1
	}
}
