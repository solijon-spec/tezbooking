# TezBooking AI chat sozlamalari.
# 1) Shu faylni nusxalab, nomini ".env" qiling (bir xil papkada).
# 2) Pastdagi qatorga Claude API kalitingizni qo'ying (https://platform.claude.com -> API Keys).
# .env faylini hech kimga yubormang va GitHub'ga yuklamang.

ANTHROPIC_API_KEY=

# Admin panel paroli (admin panel: http://localhost:3001). Bo'sh qoldirilsa, admin panel o'chiq bo'ladi.
# Kamida 12 belgili, boshqa joyda ishlatilmagan parol yozing.
ADMIN_PASSWORD=

# Owner Console (/owner): egasining emaili va parol xeshi (npm run owner:password). Ikkalasi bo'lmasa — kirish o'chiq.
OWNER_EMAIL=
OWNER_PASSWORD_HASH=
OWNER_DB_FILE=data/owner-os.db

# Optional Main Agent parsing; with no key the deterministic parser is used.
# Provider errors are surfaced and do not silently fall back.
AGENT_LLM_ENABLED=0
AGENT_LLM_PROVIDER=anthropic
AGENT_LLM_MODEL=
AGENT_LLM_API_KEY=

# Telegram bot (tur agentliklar uchun kanal postlari, UZ/RU). Token: Telegram'da @BotFather → /newbot.
# Bo'sh bo'lsa — bot o'chiq. Firma botga saytdagi kod bilan ulanadi: /link 123456
TELEGRAM_BOT_TOKEN=
# TELEGRAM_OPEN=1                   # ulanmagan foydalanuvchilarga ham ruxsat (faqat sinov uchun)
# TELEGRAM_DEMO=1                   # demo narxlar bilan sinash (postda "DEMO" yoziladi). npm run demo da avtomatik

# Xavfsizlik qalqoni (server/security.js) — sukut bo'yicha yoqilgan
# SHIELD=off                        # o'chirish (tavsiya etilmaydi)
# SHIELD_ALLOW_IPS=203.0.113.5      # hech qachon bloklanmaydigan IP'lar (ofisingiz), vergul bilan
# SHIELD_MAX_PER_MIN=600            # bitta IP'dan daqiqasiga so'rovlar; oshsa — 10 daqiqa blok
# CHAT_REQUIRE_LOGIN=1              # AI chat faqat kirgan tur firmalarga (production'da sukut bo'yicha 1)
# AGENCY_SELF_REGISTER=0            # firmalarning o'zi ro'yxatdan o'tishini yopish (faqat admin yaratadi)
# LIVE_TOUR_TICKETS=1               # turlarga operatorning alohida chipta sahifasidan reys va chipta narxini biriktirishga urinish
#                                   # (sukut bo'yicha o'chiq: sinovda operatorlar charter chipta narxini ochiq bermadi)

# Ixtiyoriy sozlamalar:
# PORT=3000                         # sayt
# ADMIN_PORT=3001                   # admin panel (alohida). 0 — sayt ichida: /admin
# CHAT_MODEL=claude-sonnet-5-5      # javob beruvchi model
# GUARD_MODEL=claude-haiku-5-5      # savol mavzusini tekshiruvchi tez model
# TOPIC_GUARD=on                    # off qilsangiz, faqat asosiy modelning cheklovi qoladi
# DB_FILE=data/tezbooking.db        # bronlar bazasi fayli
# LIVE_GLOBAL_CONCURRENCY=12        # barcha operatorlar bo'yicha bir vaqtdagi qidiruvlar
# LIVE_OPERATOR_CONCURRENCY=2       # bitta operatorga parallel so'rovlar
# LIVE_MAX_QUEUE=200                # navbatdagi operator vazifalarining yuqori chegarasi
# LIVE_RATE_PER_MIN=20              # bitta IP uchun live API so'rovlari
# LIVE_GLOBAL_RATE_PER_MIN=300      # barcha IP'lar uchun live API so'rovlari
# LIVE_TIMEOUT_MS=25000             # operator qidiruvi uchun maksimal vaqt
# Serverga joylashda (deploy/setup.sh o'zi yozadi): NODE_ENV=production, TRUST_PROXY=1 (Caddy orqasida), COOKIE_SECURE=1 (HTTPS)
# PAYMENT_MODE=manual              # manual — admin to'lovni qo'lda tasdiqlaydi (bank o'tkazmasi, naqd)
#                                   # demo   — sinov uchun, to'lov pulsiz darhol tasdiqlanadi. Haqiqiy saytda yoqmang!
